---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { enabledLocales } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return enabledLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang);

const sections = ['selection', 'sources', 'conflicts', 'ai', 'personas'] as const;
---

<BaseLayout lang={lang} title={t('methodik.heading')} description={t('methodik.intro')} path="/methodik/">
  <h1>{t('methodik.heading')}</h1>
  <p>{t('methodik.intro')}</p>
  <p>
    {t('footer.health_notice_prefix')}
    <a href={getRelativeLocaleUrl(lang, '/hinweis/')}>{t('nav.hinweis')}</a>.
  </p>

  {
    sections.map((section) => (
      <section>
        <h2>{t(`methodik.section.${section}.heading`)}</h2>
        <p>{t(`methodik.section.${section}.body`)}</p>
        {section === 'sources' && (
          <p>
            <a
              href="https://github.com/drjdh-crypto/wearables/blob/main/docs/quellenbewertung.md"
              rel="noopener"
            >
              {t('methodik.section.sources.link')}
            </a>
          </p>
        )}
      </section>
    ))
  }
</BaseLayout>
