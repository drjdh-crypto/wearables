---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { enabledLocales } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/utils';
import { CATEGORY_VALUES } from '../../../content.config';

export async function getStaticPaths() {
  return enabledLocales.flatMap((lang) =>
    CATEGORY_VALUES.map((cluster) => ({ params: { lang, cluster } })),
  );
}

const { lang, cluster } = Astro.params;
const t = useTranslations(lang);

const articles = await getCollection(
  'articles',
  ({ data }) => !data.entwurf && data.sprache === lang && data.kategorie === cluster,
);

const saeule = articles.find((a) => a.data.istSaeule);
const weitere = articles.filter((a) => a !== saeule);
---

<BaseLayout
  lang={lang}
  title={t(`kategorie.${cluster}.titel`)}
  description={t(`kategorie.${cluster}.intro`)}
  path={`/themen/${cluster}/`}
  wide
>
  <h1>{t(`kategorie.${cluster}.titel`)}</h1>
  <p>{t(`kategorie.${cluster}.intro`)}</p>

  {
    saeule && (
      <article class="pillar-card">
        <p class="tag">{t('themen.pillar_label')}</p>
        <h2>
          <a href={getRelativeLocaleUrl(lang, `/artikel/${saeule.id}/`)}>{saeule.data.titel}</a>
        </h2>
        <p>{saeule.data.beschreibung}</p>
      </article>
    )
  }

  <h2>{t('themen.all_articles_heading')}</h2>
  {
    weitere.length === 0 ? (
      <p class="cluster-empty">{t('themen.empty')}</p>
    ) : (
      <ul class="article-list">
        {weitere.map((a) => (
          <li>
            <a href={getRelativeLocaleUrl(lang, `/artikel/${a.id}/`)}>{a.data.titel}</a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .pillar-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    padding: var(--space-4);
    margin: var(--space-4) 0;
  }
</style>
