---
// Unprefixed root. With i18n routing.prefixDefaultLocale = true, every real page
// lives under /de/ or /en/ — this page's only job is to send first-time visitors
// to the right one. Preference source, in order: stored `pref:lang` (set by
// LanguageSwitcher on every localized page) → browser language → defaultLocale.
// Deliberately no IP geolocation (CLAUDE.md Abschnitt 7).
import { enabledLocales, defaultLocale } from '../i18n/config';

const enabledJson = JSON.stringify(enabledLocales);
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Schlaf- & Recovery-Tracking</title>
    <script define:vars={{ enabledLocales: enabledJson, defaultLocale }} is:inline>
      (function () {
        var enabled = JSON.parse(enabledLocales);
        var target = defaultLocale;
        try {
          var stored = localStorage.getItem('pref:lang');
          if (stored && enabled.indexOf(stored) !== -1) {
            target = stored;
          } else {
            var browserLang = (navigator.language || defaultLocale).slice(0, 2).toLowerCase();
            if (enabled.indexOf(browserLang) !== -1) {
              target = browserLang;
            }
          }
        } catch (e) {}
        location.replace('/' + target + '/');
      })();
    </script>
  </head>
  <body>
    <noscript>
      <p>
        <a href="/de/">Deutsch</a> · <a href="/en/">English</a>
      </p>
    </noscript>
  </body>
</html>
