---
// Entwurfs-Vorschau für Artikel mit entwurf:true — gebaut, aber bewusst
// unauffindbar: noindex, kein Eintrag in Navigation/Sitemap/Feed (letztere
// existieren aktuell ohnehin nicht im Projekt; falls sie hinzukommen, MÜSSEN
// sie /entwurf/* ausschließen). Erreichbar ausschließlich über die direkte
// URL, die die Redaktions-Pipeline am Ende jedes Laufs ausgibt (siehe
// /agents/README.md, "Handy-Workflow"). Layout entspricht der echten
// Artikelseite (src/pages/[lang]/artikel/[slug].astro), ergänzt um den
// mobilen ReviewBlock am Ende.
import { getCollection, render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Chart from '../../components/Chart.astro';
import KeyFindingsBox from '../../components/KeyFindingsBox.astro';
import PraxisFazit from '../../components/PraxisFazit.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import SourcesBox from '../../components/SourcesBox.astro';
import PersonaOpinionBlock from '../../components/PersonaOpinionBlock.astro';
import ProductBox from '../../components/ProductBox.astro';
import ReviewBlock from '../../components/ReviewBlock.astro';
import { useTranslations } from '../../i18n/utils';
import { estimateReadingMinutes, latestHistoryEntry } from '../../lib/reading-time';

export async function getStaticPaths() {
  const drafts = await getCollection('articles', ({ data }) => data.entwurf);
  return drafts.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const lang = article.data.sprache;
const t = useTranslations(lang);
const { Content, headings } = await render(article);

const readingMinutes = estimateReadingMinutes(article.body);
const geprueft = latestHistoryEntry(article.data.historie);
---

<BaseLayout
  lang={lang}
  title={`${t('review.heading')}: ${article.data.titel}`}
  description={article.data.beschreibung}
  wide
  noindex
>
  <div class="article-layout">
    <TableOfContents headings={headings} lang={lang} />

    <article class="article-main">
      <p class="cluster-link">
        {t('article.cluster_link_prefix')}{' '}
        <a href={getRelativeLocaleUrl(lang, `/themen/${article.data.kategorie}/`)}>
          {t(`kategorie.${article.data.kategorie}.titel`)}
        </a>
      </p>

      <h1>{article.data.titel}</h1>

      <p class="article-meta mono">
        {t('article.reading_time', { minutes: readingMinutes })}
        {' · '}
        {t('article.reviewed_on', { date: geprueft.datum.toLocaleDateString(lang) })}
      </p>

      {article.data.heroChart && <Chart id={article.data.heroChart} lang={lang} />}

      <KeyFindingsBox
        kernaussagen={article.data.kernaussagen}
        quellenanzahl={article.data.quellen.length}
        lang={lang}
      />

      <div class="article-body">
        <Content />
      </div>

      {article.data.praxisfazit && <PraxisFazit punkte={article.data.praxisfazit} lang={lang} />}

      {article.data.produkte.map((id: string) => <ProductBox id={id} lang={lang} />)}

      <PersonaOpinionBlock
        personaSlugs={article.data.personas}
        lang={lang}
        seed={article.id}
        meinungen={article.data.meinungen}
      />

      <SourcesBox quellen={article.data.quellen} lang={lang} />

      <p class="ai-notice">{t('footer.ai_notice')}</p>
      <p class="ai-notice">
        {t('footer.health_notice_prefix')}
        <a href={getRelativeLocaleUrl(lang, '/hinweis/')}>{t('nav.hinweis')}</a>.
      </p>

      <ReviewBlock quellen={article.data.quellen} offenePunkte={article.data.offenePunkte} lang={lang} />
    </article>
  </div>
</BaseLayout>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  @media (min-width: 960px) {
    .article-layout {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--space-5);
    }

    :global(.article-toc) {
      position: sticky;
      top: var(--space-4);
    }
  }

  .article-meta {
    color: var(--color-ink-muted);
    font-size: 0.8rem;
  }

  .cluster-link {
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }

  .article-body {
    max-width: 70ch;
  }

  .article-body :global(.chart) {
    max-width: min(100%, 54rem);
  }

  .ai-notice {
    margin-top: var(--space-5);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }
</style>
