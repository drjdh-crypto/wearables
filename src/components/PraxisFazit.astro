---
// Praxis-Fazit-Box — CLAUDE.md Abschnitt 2, "Praxis-Fazit": EINE Box am Artikelende mit 2-4
// Punkten, die die wichtigsten Konsequenzen aus dem Gesamttext zusammenfassen, in
// Alltagssprache ohne Fachjargon. Wird vom Artikel-Layout automatisch gerendert
// (article.data.praxisfazit), nicht inline im Body verwendet.
import { useTranslations } from '../i18n/utils';

interface Props {
  punkte: string[];
  lang: string;
}

const { punkte, lang } = Astro.props;
const t = useTranslations(lang);
---

{
  punkte.length > 0 && (
    <aside class="praxisfazit">
      <h2>{t('praxisfazit.heading')}</h2>
      <ul>
        {punkte.map((punkt) => <li>{punkt}</li>)}
      </ul>
    </aside>
  )
}

<style>
  .praxisfazit {
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-signal);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4);
    margin: var(--space-5) 0;
  }

  .praxisfazit h2 {
    font-size: 1.1rem;
    margin: 0 0 var(--space-2);
  }

  .praxisfazit ul {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: var(--space-2);
  }
</style>
