---
// Kernaussagen-Box ("Das sagt die Studienlage") — steht direkt unter dem
// Hero-Chart, bevor der eigentliche Fließtext beginnt. Ersetzt nicht das
// Quellenverzeichnis (SourcesBox), zeigt aber dessen Umfang auf einen Blick.
import { useTranslations } from '../i18n/utils';

interface Props {
  kernaussagen: string[];
  quellenanzahl: number;
  lang: string;
}

const { kernaussagen, quellenanzahl, lang } = Astro.props;
const t = useTranslations(lang);
---

<aside class="key-findings">
  <h2>{t('keyfindings.heading')}</h2>
  <ul>
    {kernaussagen.map((satz) => <li>{satz}</li>)}
  </ul>
  <p class="key-findings-count mono">{t('sources.count', { count: quellenanzahl })}</p>
</aside>

<style>
  .key-findings {
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-signal);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4);
    margin: var(--space-4) 0;
  }

  .key-findings h2 {
    font-size: 1rem;
    margin: 0 0 var(--space-2);
  }

  .key-findings ul {
    margin: 0 0 var(--space-2);
    padding-left: 1.2rem;
  }

  .key-findings-count {
    font-size: 0.8rem;
    color: var(--color-ink-muted);
    margin: 0;
  }
</style>
