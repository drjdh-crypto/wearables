---
// Manual override for the OS color-scheme preference. The actual token swap
// happens purely via CSS (see /src/styles/tokens.css: :root[data-theme]); this
// component only flips the attribute and persists the choice. The inline script
// in BaseLayout applies any stored preference before first paint to avoid a
// flash of the wrong theme.
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<button id="theme-toggle" type="button" aria-label={t('theme.toggle')} title={t('theme.toggle')}>
  {t('theme.short')}
</button>

<script>
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const stored = root.getAttribute('data-theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const current = stored ?? (prefersDark ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('pref:theme', next);
    } catch (e) {}
  });
</script>
