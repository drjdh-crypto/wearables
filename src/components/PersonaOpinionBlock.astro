---
// "Persona-Meinungsblock": zeigt 3 Stimmen aus der Persona-Liste eines Artikels,
// jede klar als "KI-Perspektive: [Name]" gekennzeichnet (CLAUDE.md Abschnitt 5).
//
// Zwei Modi:
// 1. `meinungen` gesetzt (Pipeline-Schritt 4, /agents/pipeline/04-persona-stimmen.md):
//    rendert die dort hinterlegten, themenspezifischen Statements direkt.
// 2. `meinungen` fehlt: wählt deterministisch 3 Personas aus `personaSlugs` aus (Hash über
//    `seed`, typischerweise der Artikel-Slug) und zeigt deren generische Stimme
//    (`voices.<lang>.intro`) — Fallback für Artikel ohne eigene Pipeline-Meinungen.
import { getCollection } from 'astro:content';
import PersonaAvatar from './PersonaAvatar.astro';
import { useTranslations } from '../i18n/utils';
import { defaultLocale } from '../i18n/config';

interface Meinung {
  persona: string;
  de: string;
  en: string;
  es?: string;
}

interface Props {
  personaSlugs: string[];
  lang: string;
  seed: string;
  meinungen?: Meinung[];
}

const { personaSlugs, lang, seed, meinungen } = Astro.props;
const t = useTranslations(lang);

const allPersonas = await getCollection('personas');

function hashString(input: string): number {
  let hash = 0;
  for (let i = 0; i < input.length; i++) {
    hash = (hash * 31 + input.charCodeAt(i)) >>> 0;
  }
  return hash;
}

function pickThree<T>(items: T[], seedValue: string): T[] {
  if (items.length <= 3) return items;
  const start = hashString(seedValue) % items.length;
  return [...items.slice(start), ...items.slice(0, start)].slice(0, 3);
}

type Entry = { persona: (typeof allPersonas)[number]; text: string };

let entries: Entry[];

if (meinungen && meinungen.length > 0) {
  entries = meinungen
    .map((m) => {
      const persona = allPersonas.find((p) => p.id === m.persona);
      if (!persona) return null;
      const text = (m as Record<string, string | undefined>)[lang] ?? m.de;
      return { persona, text };
    })
    .filter((e): e is Entry => e !== null);
} else {
  const eligible = allPersonas.filter((p) => personaSlugs.includes(p.id));
  entries = pickThree(eligible, seed).map((persona) => {
    const voice = persona.data.voices[lang] ?? persona.data.voices[defaultLocale];
    return { persona, text: voice.intro };
  });
}
---

{
  entries.length > 0 && (
    <section class="persona-opinion-block" aria-label={t('personas.heading')}>
      {entries.map(({ persona, text }) => (
        <div class="persona-opinion">
          <PersonaAvatar slug={persona.id} name={persona.data.name} size={40} />
          <div class="persona-opinion-text">
            <p class="persona-opinion-label">
              {t('persona.label', { name: persona.data.name })}
              {persona.data.quality_gate && (
                <span class="badge">{t('persona.quality_gate_badge')}</span>
              )}
            </p>
            <p class="persona-voice">&ldquo;{text}&rdquo;</p>
            <p class="persona-disclaimer">{t('persona.disclaimer')}</p>
          </div>
        </div>
      ))}
    </section>
  )
}

<style>
  .persona-opinion-block {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }

  .persona-opinion {
    display: flex;
    gap: var(--space-3);
    border-left: 2px solid var(--color-signal);
    padding-left: var(--space-3);
  }

  .persona-opinion-text {
    min-width: 0;
  }

  .persona-opinion-label {
    font-family: var(--font-mono-family);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
</style>
