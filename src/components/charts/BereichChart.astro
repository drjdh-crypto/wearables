---
// Spannweiten-/Boxplot-artiges Diagramm ("bereich", CLAUDE.md Abschnitt 2, "Diagramme") — ein
// oder mehrere schwebende Balken von `von` bis `bis` auf einer gemeinsamen Achse, optional mit
// einer Median-/Mittelwert-Markierung (`mitte`), mit sichtbarer Referenzlinie. Für
// Spannweiten/Streuungen über mehrere Geräte oder Studien ("0,26 bis 0,69 je nach Gerät") oder
// Abweichungen von einem Referenzwert mit Konfidenzintervall — nie für eine einzelne Zahl ohne
// Streuung (dafür bleibt die Zahl im Fließtext, siehe CLAUDE.md).
import ChartSource from './ChartSource.astro';
import { linearScale, padDomain } from '../../lib/chart-scale';

interface Props {
  titel: string;
  einheit?: string;
  daten: { label: string; von: number; bis: number; mitte?: number }[];
  datenquelle: { zitat: string; doi?: string; url: string };
  hinweis: string;
  lang: string;
  domain?: [number, number];
}

const { titel, einheit, daten, datenquelle, hinweis, lang, domain } = Astro.props;

const width = 600;
const rowHeight = 64;
const marginLeft = 12;
const marginRight = 12;
const marginTop = 8;
const height = marginTop + daten.length * rowHeight + 8;

const allValues = daten.flatMap((d) => [d.von, d.bis, d.mitte, 0].filter((v): v is number => v != null));
const [domainMin, domainMax] = domain ?? padDomain(Math.min(...allValues), Math.max(...allValues), 0.12);
const xScale = linearScale([domainMin, domainMax], [marginLeft, width - marginRight]);
const zeroVisible = domainMin < 0 && domainMax > 0;
const zeroX = xScale(0);

const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(2));

const rows = daten.map((d, i) => {
  const y = marginTop + i * rowHeight;
  const barY = y + 40;
  const x1 = xScale(Math.min(d.von, d.bis));
  const x2 = xScale(Math.max(d.von, d.bis));
  const mitteX = d.mitte != null ? xScale(d.mitte) : undefined;
  return { ...d, y, barY, x1, x2, mitteX };
});
---

<figure class="chart chart-bereich">
  <p class="chart-title">{titel}{einheit ? ` (${einheit})` : ''}</p>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={titel} preserveAspectRatio="xMidYMid meet">
    {zeroVisible && (
      <line x1={zeroX} y1={marginTop - 2} x2={zeroX} y2={height - 4} class="bereich-zero" />
    )}
    {rows.map((row) => (
      <>
        <text x={marginLeft} y={row.y + 12} class="bereich-label">{row.label}</text>
        <line x1={row.x1} y1={row.barY} x2={row.x2} y2={row.barY} class="bereich-bar" />
        <circle cx={row.x1} cy={row.barY} r="4" class="bereich-cap" />
        <circle cx={row.x2} cy={row.barY} r="4" class="bereich-cap" />
        <text x={row.x1} y={row.barY + 18} text-anchor={row.x1 <= row.x2 ? 'end' : 'start'} class="bereich-value">
          {fmt(row.von)}
        </text>
        <text x={row.x2} y={row.barY + 18} text-anchor={row.x2 >= row.x1 ? 'start' : 'end'} class="bereich-value bereich-value-end">
          {fmt(row.bis)}{einheit ?? ''}
        </text>
        {row.mitteX != null && (
          <>
            <rect
              x={row.mitteX - 5}
              y={row.barY - 5}
              width="10"
              height="10"
              transform={`rotate(45 ${row.mitteX} ${row.barY})`}
              class="bereich-mitte"
            />
            <text x={row.mitteX} y={row.barY - 12} text-anchor="middle" class="bereich-mitte-value">
              {fmt(row.mitte as number)}{einheit ?? ''}
            </text>
          </>
        )}
      </>
    ))}
  </svg>
  <ChartSource datenquelle={datenquelle} hinweis={hinweis} lang={lang} />
</figure>

<style>
  .chart {
    margin: var(--space-4) 0;
  }

  .chart-title {
    font-family: var(--font-heading);
    font-weight: 600;
    margin: 0 0 var(--space-2);
    color: var(--color-ink);
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .bereich-zero {
    stroke: var(--color-border);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }

  .bereich-label {
    font-family: var(--font-body);
    font-size: 13px;
    fill: var(--color-ink-muted);
  }

  .bereich-bar {
    stroke: var(--color-signal);
    stroke-width: 6;
    stroke-linecap: round;
    opacity: 0.5;
  }

  .bereich-cap {
    fill: var(--color-signal);
  }

  .bereich-value {
    font-family: var(--font-mono-family);
    font-size: 12px;
    fill: var(--color-ink-muted);
  }

  .bereich-mitte {
    fill: var(--color-signal);
    stroke: var(--color-surface);
    stroke-width: 1.5;
  }

  .bereich-mitte-value {
    font-family: var(--font-mono-family);
    font-weight: 600;
    font-size: 13px;
    fill: var(--color-ink);
  }
</style>
