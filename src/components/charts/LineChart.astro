---
// Liniendiagramm, SVG. x-Achse ist ordinal (gleichmäßig verteilte Stützpunkte,
// beschriftet mit dem jeweiligen x-Wert) — passend für Zeitreihen wie
// "HRV über 7 Nächte". Farben ausschließlich aus den Theme-Tokens.
import ChartSource from './ChartSource.astro';
import { linearScale, niceMax } from '../../lib/chart-scale';

interface Props {
  titel: string;
  einheit?: string;
  daten: { x: string | number; y: number }[];
  datenquelle: { zitat: string; doi?: string; url: string };
  hinweis: string;
  lang: string;
}

const { titel, einheit, daten, datenquelle, hinweis, lang } = Astro.props;

const width = 640;
const height = 320;
const marginTop = 24;
const marginBottom = 40;
const marginX = 24;
const plotWidth = width - marginX * 2;
const plotHeight = height - marginTop - marginBottom;

const maxValue = niceMax(Math.max(...daten.map((d) => d.y)));
const yScale = linearScale([0, maxValue], [plotHeight, 0]);
const baselineY = marginTop + plotHeight;

const step = daten.length > 1 ? plotWidth / (daten.length - 1) : 0;
const points = daten.map((d, i) => ({
  ...d,
  cx: marginX + i * step,
  cy: marginTop + yScale(d.y),
}));

const polylinePoints = points.map((p) => `${p.cx},${p.cy}`).join(' ');
---

<figure class="chart">
  <p class="chart-title">{titel}{einheit ? ` (${einheit})` : ''}</p>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={titel} preserveAspectRatio="xMidYMid meet">
    <line x1={marginX} y1={baselineY} x2={width - marginX} y2={baselineY} class="chart-axis" />
    <polyline points={polylinePoints} class="chart-line" />
    {points.map((p) => (
      <circle cx={p.cx} cy={p.cy} r="4" class="chart-point" />
    ))}
    {points.map((p) => (
      <text x={p.cx} y={p.cy - 12} text-anchor="middle" class="chart-value">
        {p.y}
      </text>
    ))}
    {points.map((p) => (
      <text x={p.cx} y={baselineY + 20} text-anchor="middle" class="chart-label">
        {p.x}
      </text>
    ))}
  </svg>
  <ChartSource datenquelle={datenquelle} hinweis={hinweis} lang={lang} />
</figure>

<style>
  .chart {
    margin: var(--space-4) 0;
  }

  .chart-title {
    font-family: var(--font-heading);
    font-weight: 600;
    margin: 0 0 var(--space-2);
    color: var(--color-ink);
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .chart-axis {
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .chart-line {
    fill: none;
    stroke: var(--color-signal);
    stroke-width: 2;
  }

  .chart-point {
    fill: var(--color-signal);
  }

  .chart-value {
    font-family: var(--font-mono-family);
    font-size: 13px;
    fill: var(--color-ink);
  }

  .chart-label {
    font-family: var(--font-body);
    font-size: 13px;
    fill: var(--color-ink-muted);
  }
</style>
