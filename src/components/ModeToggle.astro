---
// Light/Dark override, independent from ThemeSwitcher.astro (Lean/Health).
// The actual token swap happens purely via CSS (see /src/styles/tokens.css:
// [data-mode]); this component only flips the attribute and persists the
// choice. The inline script in BaseLayout applies any stored preference
// before first paint to avoid a flash of the wrong mode.
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<button id="mode-toggle" type="button" aria-label={t('mode.toggle')} title={t('mode.toggle')}>
  {t('mode.short')}
</button>

<script>
  const toggle = document.getElementById('mode-toggle');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const stored = root.getAttribute('data-mode');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const current = stored ?? (prefersDark ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-mode', next);
    try {
      localStorage.setItem('pref:mode', next);
    } catch (e) {}
  });
</script>
