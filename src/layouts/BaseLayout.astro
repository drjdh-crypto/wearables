---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { enabledLocales } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import RegionSwitcher from '../components/RegionSwitcher.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  lang: string;
  title: string;
  description?: string;
  /** Canonical path within a locale, e.g. "/personas/". Used to build hreflang alternates. */
  path?: string;
}

const { lang, title, description, path = '/' } = Astro.props;
const t = useTranslations(lang);
const pageDescription = description ?? t('site.description');
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <title>{title}</title>

    {enabledLocales.map((locale) => (
      <link rel="alternate" hreflang={locale} href={getRelativeLocaleUrl(locale, path)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={getRelativeLocaleUrl('de', path)} />

    <script is:inline>
      // Applies a stored theme preference before paint to avoid a flash of the
      // wrong theme. Falls back to the OS preference (handled entirely in CSS)
      // when nothing is stored yet — see /src/styles/tokens.css.
      try {
        const stored = localStorage.getItem('pref:theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="site-brand" href={getRelativeLocaleUrl(lang, '/')}>
        <span class="site-name">{t('home.heading')}</span>
        <span class="site-tagline">{t('site.tagline')}</span>
      </a>
      <nav class="site-nav">
        <a href={getRelativeLocaleUrl(lang, '/')}>{t('nav.home')}</a>
        <a href={getRelativeLocaleUrl(lang, '/personas/')}>{t('nav.personas')}</a>
      </nav>
      <div class="site-switchers">
        <LanguageSwitcher lang={lang} path={path} />
        <RegionSwitcher lang={lang} />
        <ThemeToggle lang={lang} />
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <nav class="footer-nav">
        <a href={getRelativeLocaleUrl(lang, '/impressum/')}>{t('nav.impressum')}</a>
        <a href={getRelativeLocaleUrl(lang, '/datenschutz/')}>{t('nav.datenschutz')}</a>
      </nav>
      <p class="footer-rights">{t('footer.rights')}</p>
    </footer>
  </body>
</html>
