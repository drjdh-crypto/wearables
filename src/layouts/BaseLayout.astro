---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { enabledLocales } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import RegionSwitcher from '../components/RegionSwitcher.astro';
import ModeToggle from '../components/ModeToggle.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import '../styles/global.css';

interface Props {
  lang: string;
  title: string;
  description?: string;
  /** Canonical path within a locale, e.g. "/personas/". Used to build hreflang alternates. */
  path?: string;
  /** Wider content column for hub/listing pages (homepage, cluster pages) — article pages stay at the default, narrower reading width. */
  wide?: boolean;
  /**
   * Draft previews (/entwurf/<slug>/, see src/pages/entwurf/[slug].astro): adds
   * robots noindex,nofollow and skips hreflang/LanguageSwitcher, since the page
   * doesn't exist at an equivalent path in other locales. Never set on public
   * article/hub pages.
   */
  noindex?: boolean;
}

const { lang, title, description, path = '/', wide = false, noindex = false } = Astro.props;
const t = useTranslations(lang);
const pageDescription = description ?? t('site.description');
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <title>{title}</title>

    {noindex && <meta name="robots" content="noindex,nofollow" />}

    {!noindex && (
      <>
        {enabledLocales.map((locale) => (
          <link rel="alternate" hreflang={locale} href={getRelativeLocaleUrl(locale, path)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={getRelativeLocaleUrl('de', path)} />
      </>
    )}

    <script is:inline>
      // Applies stored theme/mode preferences before paint to avoid a flash of
      // the wrong look. Two independent settings (CLAUDE.md/Design-Tokens):
      // pref:theme (lean/health) and pref:mode (light/dark, falls back to OS
      // preference via CSS when unset) — see /src/styles/tokens.css.
      try {
        const theme = localStorage.getItem('pref:theme');
        if (theme === 'health') {
          document.documentElement.setAttribute('data-theme', 'health');
        }
        const mode = localStorage.getItem('pref:mode');
        if (mode === 'light' || mode === 'dark') {
          document.documentElement.setAttribute('data-mode', mode);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="site-brand" href={getRelativeLocaleUrl(lang, '/')}>
        <span class="site-name">{t('home.heading')}</span>
        <span class="site-tagline">{t('site.tagline')}</span>
      </a>
      <nav class="site-nav">
        <a href={getRelativeLocaleUrl(lang, '/')}>{t('nav.home')}</a>
        <a href={getRelativeLocaleUrl(lang, '/personas/')}>{t('nav.personas')}</a>
        <a href={getRelativeLocaleUrl(lang, '/methodik/')}>{t('nav.methodik')}</a>
      </nav>
      <div class="site-switchers">
        {!noindex && <LanguageSwitcher lang={lang} path={path} />}
        <RegionSwitcher lang={lang} />
        <ThemeSwitcher lang={lang} />
        <ModeToggle lang={lang} />
      </div>
    </header>

    <main class={wide ? 'wide' : ''}>
      <slot />
    </main>

    <footer class="site-footer">
      <nav class="footer-nav">
        <a href={getRelativeLocaleUrl(lang, '/impressum/')}>{t('nav.impressum')}</a>
        <a href={getRelativeLocaleUrl(lang, '/datenschutz/')}>{t('nav.datenschutz')}</a>
        <a href={getRelativeLocaleUrl(lang, '/hinweis/')}>{t('nav.hinweis')}</a>
      </nav>
      <p class="footer-rights">{t('footer.rights')}</p>
    </footer>
  </body>
</html>
